rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin (autenticado) tem acesso total a clientes, projetos e orçamentos.
    match /clients/{clientId} {
      allow read, write: if request.auth != null;
      // Área do cliente pública: consegue ler pelo slug (via query "where slug ==")
      // mas NUNCA listar a coleção inteira sem autenticação.
      allow list: if request.auth != null
        || (request.query.limit <= 1 && 'slug' in request.query.filters);
      allow get: if true; // leitura direta por ID (não usada pelo app, mas liberada)
    }

    match /projects/{projectId} {
      allow read, write: if request.auth != null;
      allow list: if request.auth != null
        || (request.query.limit <= 1 && 'clientId' in request.query.filters);
    }

    match /quotes/{quoteId} {
      allow read, write: if request.auth != null;
      // Proposta pública (/proposta/:slug): visitante consegue localizar UM
      // orçamento pelo slug, mas nunca listar a coleção inteira sem login.
      allow list: if request.auth != null
        || (request.query.limit <= 1 && 'slug' in request.query.filters);
      allow get: if true;
      // Cliente pode aprovar/recusar pelo link público, mas só pode alterar
      // os campos de status — nada mais no documento (valor, prazo etc.
      // continuam só editáveis pelo admin autenticado).
      allow update: if request.auth != null
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusUpdatedAt'])
            && request.resource.data.status in ['aprovado', 'recusado']);
    }

    match /contracts/{contractId} {
      allow read, write: if request.auth != null;
      // Contrato público (/contrato/:slug): mesma lógica das propostas —
      // localizável só pelo slug, nunca listável, e o cliente só pode
      // marcar aceite (nunca alterar valor, prazo, texto etc.).
      allow list: if request.auth != null
        || (request.query.limit <= 1 && 'slug' in request.query.filters);
      allow get: if true;
      allow update: if request.auth != null
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt'])
            && request.resource.data.status == 'aceito');
    }

    // Briefing: qualquer visitante pode CRIAR (enviar formulário),
    // mas só admin autenticado pode LER as respostas.
    match /formSubmissions/{subId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
