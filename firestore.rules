rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /{kind}/{id} {
      allow read, write: if admin() && kind in ['clients','projects','quotes','contracts','formSubmissions','payments'];
    }
    match /siteContent/{id} { allow read: if true; allow write: if admin(); }
    match /publicClients/{slug} {
      allow get: if true;
      allow list: if admin();
      allow write: if admin();
    }
    match /publicQuotes/{slug} {
      allow get: if true;
      allow list, create, delete: if admin();
      allow update: if admin() || (
        resource.data.status == 'pendente' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','statusUpdatedAt']) &&
        request.resource.data.status in ['aprovado','recusado'] &&
        request.resource.data.statusUpdatedAt == request.time
      );
    }
    match /publicContracts/{slug} {
      allow get: if true;
      allow list, create, delete: if admin();
      allow update: if admin() || (
        resource.data.status == 'pendente' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','acceptedAt']) &&
        request.resource.data.status == 'aceito' &&
        request.resource.data.acceptedAt == request.time
      );
    }
    match /formSubmissions/{id} {
      allow create: if request.resource.data.keys().hasOnly(['clientSlug','answers','createdAt']) &&
        request.resource.data.clientSlug is string &&
        exists(/databases/$(database)/documents/publicClients/$(request.resource.data.clientSlug)) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.answers.keys().hasOnly(['negocio','publico','objetivo','cores','referencias']) &&
        request.resource.data.answers.negocio is string && request.resource.data.answers.negocio.size() > 0 && request.resource.data.answers.negocio.size() <= 4000 &&
        request.resource.data.answers.publico is string && request.resource.data.answers.publico.size() <= 4000 &&
        request.resource.data.answers.objetivo is string && request.resource.data.answers.objetivo.size() > 0 && request.resource.data.answers.objetivo.size() <= 4000 &&
        request.resource.data.answers.cores is string && request.resource.data.answers.cores.size() <= 1000 &&
        request.resource.data.answers.referencias is string && request.resource.data.answers.referencias.size() <= 2000;
    }
  }
}
