{
  "name": "pedro-sistema-operacional",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "node scripts/dev-local.mjs",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-pedrodev",
    "seed:local": "node scripts/seed-local-admin.mjs",
    "test:prospects": "node --test tests/prospects.test.mjs",
    "test:search": "node --test tests/prospect-search.test.mjs",
    "test:search:http": "node --test tests/prospect-search-http.test.mjs",
    "test:prospect-api-artifact": "node --test tests/prospect-api-artifact.test.mjs",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --only firestore --project demo-pedrodev-rules \"node --test tests/firestore.rules.test.mjs\"",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "check:public": "node scripts/verify-public.mjs"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@vercel/analytics": "^2.0.1",
    "firebase": "^10.13.2",
    "framer-motion": "^14.9.1",
    "jspdf": "^2.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.6.1",
    "firebase-tools": "^13.35.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.4",
    "vite": "^5.4.6"
  }
}
