{
  "outputDirectory": "deploy",
  "rewrites": [
    { "source": "/login", "destination": "/app/index.html" },
    { "source": "/admin", "destination": "/app/index.html" },
    { "source": "/admin/:path*", "destination": "/app/index.html" },
    { "source": "/cliente/:slug", "destination": "/app/index.html" }
  ]
}
