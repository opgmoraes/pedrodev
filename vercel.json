{
  "outputDirectory": "dist",
  "env": {
    "PROSPECT_SEARCH_PROVIDER": "openstreetmap"
  },
  "redirects": [
    {
      "source": "/portfolio",
      "destination": "/portifolio",
      "permanent": true
    },
    {
      "source": "/portifolio/",
      "destination": "/portifolio",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/portifolio",
      "destination": "/portifolio/index.html"
    },
    {
      "source": "/link",
      "destination": "/link/index.html"
    },
    {
      "source": "/skills",
      "destination": "/skills/index.html"
    },
    {
      "source": "/login",
      "destination": "/private-shell.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/private-shell.html"
    },
    {
      "source": "/cliente/:path*",
      "destination": "/private-shell.html"
    },
    {
      "source": "/proposta/:path*",
      "destination": "/private-shell.html"
    },
    {
      "source": "/contrato/:path*",
      "destination": "/private-shell.html"
    },
    {
      "source": "/:path*",
      "destination": "/app-shell.html"
    }
  ]
}
